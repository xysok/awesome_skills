# ==================== 月报生成配置模板 ====================
# 用法：复制本文件为 <scripts目录>/.env 并填写；或直接设置同名系统环境变量。
# 环境变量优先级高于 .env；生成的 .env 请勿提交到版本库。
# 预览使用标准库；正式写库提炼需要 openai SDK、Base 配置与 LLM Key。

# --- 日报/周报/月报共用多维表格（必填，与日报/周报 skill 同一张表）---
DR_BASE_TOKEN=
DR_TABLE_ID=

# --- lark-cli 定位（可选）---
# 默认自动定位 npm 全局安装的 @larksuite/cli/scripts/run.js，通常无需设置
DR_LARK_RUNJS=

# --- LLM（正式写库必填，用于「工作小结（提炼）」列）---
# 不配置 DR_LLM_API_KEY 时禁止新建正式月报，不会写入半成品
DR_LLM_API_KEY=
DR_LLM_BASE=
DR_LLM_MODEL=

# --- .env 文件路径（可选）---
# 默认 <scripts目录>/.env；需要外部文件时可指定绝对路径
DR_ENV_FILE=