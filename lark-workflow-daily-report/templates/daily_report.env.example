# ==================== 日报生成配置模板 ====================
# 用法：复制本文件为 <scripts目录>/.env 并填写；或直接设置同名系统环境变量。
# 环境变量优先级高于 .env；生成的 .env 请勿提交到版本库。
# 所有键以 DR_ 为前缀，脚本每次运行重新读取，无需重启。

# --- LLM（OpenAI 兼容接口，用于把采集数据提炼为结构化日报）---
# 不配置 DR_LLM_API_KEY 时自动回退为规则提炼（不调用 LLM，报告仍会生成）。
DR_LLM_API_KEY=
# 网关 Base URL（示例：https://your-llm-gateway.example.com/v1；OpenAI 官方可留空/用默认）
DR_LLM_BASE=
# 模型名（示例：gpt-4o-mini）
DR_LLM_MODEL=

# --- 本人身份（消息归属 is_me 判断，必填）---
# 飞书 open_id，形如 ou_xxxxxxxxxxxx
DR_MY_OPEN_ID=
# 飞书显示名（群聊「@我」识别用，形如 沈宇轩；不填则群聊@检测关闭，仅单聊计入【会话消息@】）
DR_MY_NAME=

# --- 过滤（可选，逗号分隔多个）---
# 排除的机器人/应用 open_id
DR_EX_BOTS=
# 排除的会话 chat_id（群/单聊均可）
DR_EX_CHATS=

# --- 日报写入目标多维表格（仅 --write-base / cron 入口需要）---
DR_BASE_TOKEN=
DR_TABLE_ID=

# --- lark-cli 定位（可选）---
# 默认自动定位 npm 全局安装的 @larksuite/cli/scripts/run.js，通常无需设置
DR_LARK_RUNJS=

# --- .env 文件路径（可选）---
# 默认 <scripts目录>/.env；需要外部文件时可指定绝对路径
DR_ENV_FILE=